{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "preserve",
    "lib": ["es2022", "dom", "dom.iterable"],
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@mantikai/home/page": ["./libs/home/page/src/index.ts"],
      "@mantikai/privacy/page": ["./libs/privacy/page/src/index.ts"],
      "@mantikai/terms/page": ["./libs/terms/page/src/index.ts"],
      "@mantikai/consent/page": ["./libs/consent/page/src/index.ts"],
      "@mantikai/support/page": ["./libs/support/page/src/index.ts"],
      "@mantikai/delete-account/page": ["./libs/delete-account/page/src/index.ts"],
      "@mantikai/contact/page": ["./libs/contact/page/src/index.ts"],
      "@mantikai/not-found/page": ["./libs/not-found/page/src/index.ts"],
      "@mantikai/core": ["./libs/core/src/index.ts"],
      "@mantikai/ui/buttons": ["./libs/ui/buttons/src/index.ts"],
      "@mantikai/ui/header": ["./libs/ui/header/src/index.ts"],
      "@mantikai/ui/language-menu": ["./libs/ui/language-menu/src/index.ts"],
      "@mantikai/ui/footer": ["./libs/ui/footer/src/index.ts"],
      "@mantikai/ui/language-hint": ["./libs/ui/language-hint/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
